<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 아이콘 전경: 빨강→초록 그라데이션 재생 버튼 (108dp 캔버스, 가운데 66dp 안전 영역) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 모서리를 둥글게: 같은 그라데이션으로 둥근 외곽선을 함께 그림 -->
    <path
        android:pathData="M44,37 L44,71 L73,54 Z"
        android:strokeWidth="9"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="33"
                android:endX="76"
                android:endY="75">
                <item android:offset="0" android:color="#FFFF4D5E" />
                <item android:offset="1" android:color="#FF2FE08A" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="33"
                android:endX="76"
                android:endY="75">
                <item android:offset="0" android:color="#FFFF4D5E" />
                <item android:offset="1" android:color="#FF2FE08A" />
            </gradient>
        </aapt:attr>
    </path>
